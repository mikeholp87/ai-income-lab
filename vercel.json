{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://app.cal.com https://cal.com https://www.googletagmanager.com https://connect.facebook.net https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com https://www.facebook.com https://*.google-analytics.com; font-src 'self'; media-src 'self'; frame-src https://cal.com https://app.cal.com https://www.youtube-nocookie.com; connect-src 'self' https://*.cal.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.facebook.com https://vitals.vercel-insights.com; form-action 'self' https://cal.com https://www.skool.com" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }]
    },
    {
      "source": "/([^/]+\\.(?:jpg|jpeg|png|webp|svg|ico|mp4|vtt))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(members|tools)/(.*\\.(?:jpg|jpeg|png|webp|svg|ico|mp4|vtt))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(reading|consent).css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/assets/((?!reading\\.js$).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/watch/:id", "destination": "/api/videos?video=:id" },
    { "source": "/video-sitemap.xml", "destination": "/api/videos?sitemap=videos" },
    { "source": "/o/:token.gif", "destination": "/api/o/:token" },
    { "source": "/videos", "destination": "/api/videos" },
    { "source": "/videos/:page", "destination": "/api/videos?page=:page" }
  ]
}
