# Optional: the build and public pages work from saved video snapshots without this.
YOUTUBE_API_KEY=

# Server-side email tracking and suppression integrations. Never use a VITE_ prefix.
AIRTABLE_PAT=
RESEND_WEBHOOK_SECRET=
SUPPRESSION_BASE_ID=
# Optional table-name overrides; pixel routing overrides are documented in README.md.
SUPPRESSION_TABLE=Email Suppression
EVENTS_TABLE=Resend Events

# Only needed for the manual booking-import script.
CALCOM_API_KEY=

# Contact form and build-notes signup: Resend key with full access (adding contacts needs it).
RESEND_API_KEY=

# Search inside video transcripts and guides (/api/search). Without it, search pages use title matching only.
# After adding guides or transcripts, run: node scripts/supermemory-sync.mjs
SUPERMEMORY_API_KEY=

# Double opt-in signup links are signed with this. Any long random string; changing it voids unconfirmed links.
SUBSCRIBE_SECRET=
